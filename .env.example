# PLANTILLA para desarrollo local. Copia este archivo a .env y rellena los valores.
# Este archivo SI se sube a git: NUNCA lleva un valor real.
# En Railway no se usa .env: las variables van en el servicio web (ver DEPLOY.md).

# Obligatoria. Firma las cookies de sesion. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Base MySQL 8 o MariaDB 10.6+. En Railway vienen de las referencias ${{MySQL.*}}.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=turnio

# Sesiones y contadores de intentos de login. Vacio solo en desarrollo
# (sesiones en disco y contadores en memoria). En produccion es obligatoria.
# En Railway: ${{Redis.REDIS_URL}}
REDIS_URL=

# 'development' no fuerza HTTPS ni exige REDIS_URL. Vacio = produccion.
FLASK_ENV=development

# Horas sin actividad antes de cerrar la sesion (por defecto 12).
SESSION_HORAS=12

# Hora del negocio como desfase de UTC (Colombia = -5).
APP_UTC_OFFSET=-5

# Correo para recuperar contrasena e invitaciones (opcional).
# EMAIL_SENDER=
# EMAIL_PASSWORD=  contrasena de aplicacion de Google, no la de la cuenta
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# Carpeta de logs (correo y seguridad).
LOG_DIR=logs

# Concurrencia en produccion (opcionales): gunicorn workers x hilos. Conexiones
# a MySQL = workers x (hilos + 2), salvo DB_POOL_SIZE.
# WEB_CONCURRENCY=4
# GUNICORN_THREADS=4
# DB_POOL_SIZE=6
